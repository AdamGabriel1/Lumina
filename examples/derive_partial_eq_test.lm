@derive(PartialEq)
struct Ponto:
    x: int
    y: int

fn main() -> int:
    mut p1: Ponto
    p1.x = 10
    p1.y = 20

    mut p2: Ponto
    p2.x = 10
    p2.y = 20

    mut p3: Ponto
    p3.x = 10
    p3.y = 99

    print("=== PartialEq (== e !=) ===")
    print("p1 == p2?", p1 == p2)
    print("p1 == p3?", p1 == p3)
    print("p1 != p2?", p1 != p2)
    print("p1 != p3?", p1 != p3)

    return 0
