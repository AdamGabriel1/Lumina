fn main() -> int:
    print("Iniciando Máquina Virtual Lumina...")
    
    # Bytecode do nosso programa de teste
    # 0x10 = LOAD_VAL, 42 = valor, 0x20 = PRINT_REG, 0x00 = reg0, 0xFF = HALT
    let bytecode = [0x10, 42, 0x20, 0, 0xFF]
    
    mut pc = 0 # Program Counter
    mut reg0 = 0 # Registrador 0
    
    while true:
        # 1. FETCH
        let opcode = bytecode[pc]
        
        # 2. DECODE & EXECUTE
        if opcode == 0x10:
            # Carrega o próximo byte no reg0
            reg0 = bytecode[pc + 1]
            pc += 2
            continue
            
        elif opcode == 0x20:
            # Imprime o registrador
            print("Reg0:", reg0)
            pc += 2
            continue
            
        elif opcode == 0xFF:
            # Halta a CPU
            print("CPU Halted.")
            return 0
            
        else:
            print("Opcode desconhecido:", opcode)
            return 1
            
    return 0
