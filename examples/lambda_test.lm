# Função que recebe um callback (ponteiro de função)
fn aplicar_fn(val: int, callback: fn(int) -> int) -> int:
    # Converte o ponteiro i8* de volta para i64 (int) e chama
    # Na Lumina atual, chamadas dinâmicas de ponteiros exigem cast
    # Vamos simular retornando o valor fixo para testar a criação da lambda
    print("Callback recebido!")
    return val * 2

fn main() -> int:
    print("Testando Lambdas...")
    
    # Cria uma função anônima e salva seu endereço na variável 'minha_fn'
    let minha_fn = fn(x: int) -> int:
        return x + 10
        
    # Chama a função original passando o endereço da lambda
    let res = aplicar_fn(5, minha_fn)
    print("Resultado:", res)
    
    return 0