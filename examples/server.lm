# Declarações diretas das funções de socket do C (POSIX)
extern fn socket(domain: int, sock_type: int, protocol: int) -> int
extern fn setsockopt(sockfd: int, level: int, optname: int, optval: str, optlen: int) -> int
extern fn bind(sockfd: int, addr: str, addrlen: int) -> int
extern fn listen(sockfd: int, backlog: int) -> int
# CORREÇÃO: addrlen agora é str (ponteiro genérico i8*)
extern fn accept(sockfd: int, addr: str, addrlen: str) -> int
extern fn recv(sockfd: int, buf: str, len: int, flags: int) -> int
extern fn send(sockfd: int, buf: str, len: int, flags: int) -> int
extern fn close(fd: int) -> int

fn iniciar_servidor(porta: int) -> int:
    # 1. Cria o socket (AF_INET = 2, SOCK_STREAM = 1)
    let server_fd = socket(2, 1, 0)
    if server_fd < 0:
        print("Erro ao criar o socket")
        return -1
        
    # 2. SO_REUSEADDR (Evita "Address already in use" ao reiniciar)
    mut reuse = alloc_bytes(4)
    reuse[0] = 1
    # SOL_SOCKET = 1, SO_REUSEADDR = 2 no Linux
    setsockopt(server_fd, 1, 2, reuse, 4)
        
    # 3. Configura a struct sockaddr_in (16 bytes)
    mut addr = alloc_bytes(16)
    for i in 0..16:
        addr[i] = 0
        
    # Byte 0-1: Family (AF_INET = 2)
    addr[0] = 2
    addr[1] = 0
    
    # Byte 2-3: Porta em Big Endian (Network Byte Order)
    addr[2] = porta / 256
    addr[3] = porta % 256
    
    # 4. Faz o bind
    let bind_res = bind(server_fd, addr, 16)
    if bind_res < 0:
        print("Erro ao fazer bind na porta")
        close(server_fd)
        return -1
        
    # 5. Escuta conexões (backlog 10)
    listen(server_fd, 10)
    return server_fd

fn main() -> int:
    let porta = 8080
    let server_fd = iniciar_servidor(porta)
    
    if server_fd < 0:
        return 1
        
    print("Servidor Lumina rodando em http://localhost:8080")
    
    let http_response = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: 38\r\n\r\n<h1>Hello from Lumina Web Server!</h1>"
    let response_len = len(http_response)
    
    mut client_addr = alloc_bytes(16)
    
    # CORREÇÃO: Aloca 4 bytes para o ponteiro de tamanho (socklen_t) evitar corrupção de memória
    mut client_len_ptr = alloc_bytes(4)
    client_len_ptr[0] = 16
    
    mut request_buffer = alloc_bytes(1024)
    
    while true:
        let client_fd = accept(server_fd, client_addr, client_len_ptr)
        
        if client_fd >= 0:
            recv(client_fd, request_buffer, 1024, 0)
            send(client_fd, http_response, response_len, 0)
            close(client_fd)
            
    return 0