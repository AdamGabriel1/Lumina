import "std/test"

test "soma de ints":
    let f1 = check_eq(1 + 1, 2, "1+1 == 2")
    let f2 = check_eq(-1 + 1, 0, "-1+1 == 0")
    let f3 = check_ne(1, 2, "1 != 2")
    return f1 + f2 + f3

test "strings":
    let f1 = check_str_eq("a" + "b", "ab", "concat")
    return f1

test "comparações":
    let f1 = check_true(1 == 1, "1 == 1")
    let f2 = check_false(1 == 2, "1 != 2")
    return f1 + f2

test "falha proposital":
    let f1 = check_eq(1 + 1, 3, "1+1 == 3 (deve falhar)")
    return f1

fn main() -> int:
    return 0
