fn main() -> int:
    mut n = 1000000
    if len(argv(1)) > 0:
        n = atoi(argv(1))

    mut seed = 12345
    mut total = 0
    mut i = 0
    while i < n:
        seed = (seed * 1103515245 + 12345) & 0xFFFFFFFF
        mut size = ((seed >> 16) % 512) + 1

        let p = alloc_bytes(size)
        if p != nil:
            p[0] = i % 256
            black_box(p as int)             # ← barreira anti-DCE
            total = total + p[0]
            free(p)

        i = i + 1

    print("", total)
    return 0