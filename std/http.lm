## Módulo de Servidor HTTP (std/http)
## Um framework web nativo e minimalista para a Lumina.

extern fn socket(domain: int, sock_type: int, protocol: int) -> int
extern fn setsockopt(sockfd: int, level: int, optname: int, optval: str, optlen: int) -> int
extern fn bind(sockfd: int, addr: str, addrlen: int) -> int
extern fn listen(sockfd: int, backlog: int) -> int
extern fn accept(sockfd: int, addr: str, addrlen: str) -> int
extern fn recv(sockfd: int, buf: str, len: int, flags: int) -> int
extern fn send(sockfd: int, buf: str, len: int, flags: int) -> int
extern fn close(fd: int) -> int

fn iniciar(porta: int) -> int:
    let server_fd = socket(2, 1, 0)
    if server_fd < 0:
        return -1
        
    mut reuse = alloc_bytes(4)
    reuse[0] = 1
    setsockopt(server_fd, 1, 2, reuse, 4)
        
    mut addr = alloc_bytes(16)
    for i in 0..16:
        addr[i] = 0
        
    addr[0] = 2
    addr[2] = porta / 256
    addr[3] = porta % 256
    
    let bind_res = bind(server_fd, addr, 16)
    if bind_res < 0:
        close(server_fd)
        return -1
        
    listen(server_fd, 10)
    return server_fd

fn responder(client_fd: int, body: str):
    # O len(body) agora calcula o tamanho exato dinamicamente!
    let header = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: " + len(body) + "\r\nConnection: close\r\n\r\n" + body
    send(client_fd, header, len(header), 0)
    close(client_fd)

fn not_found(client_fd: int):
    let body = "<h1>404 - Pagina Nao Encontrada</h1>"
    let header = "HTTP/1.1 404 Not Found\r\nContent-Type: text/html\r\nContent-Length: " + len(body) + "\r\nConnection: close\r\n\r\n" + body
    send(client_fd, header, len(header), 0)
    close(client_fd)