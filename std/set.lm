## Set: conjunto de int usando hash table.
## Uso:
##   mut s = new_set()
##   s.add(42)
##   print(s.contains(42))   # 1
##
## Cresce automaticamente (rehash) quando size >= cap * 0.75.
struct Set:
    keys: ptr      # -1 = vazio, -2 = tombstone
    size: int
    cap: int

let SET_INITIAL_CAP = 16

fn _set_hash(key: int, cap: int) -> int:
    return key & (cap - 1)

impl Set:
    ## Rehash: dobra a capacidade e reinsere todos os elementos vivos.
    fn rehash():
        let old_keys = self.keys
        let old_cap = self.cap

        self.cap = old_cap * 2
        self.keys = alloc(self.cap)
        self.size = 0

        mut i = 0
        while i < self.cap:
            self.keys[i] = -1
            i += 1

        mut i = 0
        while i < old_cap:
            if old_keys[i] != -1 and old_keys[i] != -2:
                self.add(old_keys[i])
            i += 1

    ## Adiciona um elemento. No-op se já existe.
    fn add(key: int):
        if self.size * 4 >= self.cap * 3:
            self.rehash()

        let idx = _set_hash(key, self.cap)
        mut i = idx
        mut probes = 0
        mut first_tombstone = -1

        while probes < self.cap:
            let k = self.keys[i]
            if k == -1:
                if first_tombstone != -1:
                    self.keys[first_tombstone] = key
                else:
                    self.keys[i] = key
                self.size += 1
                return
            if k == -2:
                if first_tombstone == -1:
                    first_tombstone = i
            elif k == key:
                return
            i = (i + 1) & (self.cap - 1)
            probes += 1

    ## Retorna 1 se o elemento está no Set; senão 0.
    fn contains(key: int) -> int:
        let idx = _set_hash(key, self.cap)
        mut i = idx
        mut probes = 0
        while probes < self.cap:
            let k = self.keys[i]
            if k == -1:
                return 0
            if k == key:
                return 1
            i = (i + 1) & (self.cap - 1)
            probes += 1
        return 0

    ## Remove um elemento. Retorna 1 se removeu; 0 se não achou.
    fn remove(key: int) -> int:
        let idx = _set_hash(key, self.cap)
        mut i = idx
        mut probes = 0
        while probes < self.cap:
            let k = self.keys[i]
            if k == -1:
                return 0
            if k == key:
                self.keys[i] = -2
                self.size -= 1
                return 1
            i = (i + 1) & (self.cap - 1)
            probes += 1
        return 0

## Cria um Set vazio (função livre).
fn new_set() -> Set:
    mut s: Set
    s.cap = SET_INITIAL_CAP
    s.size = 0
    s.keys = alloc(SET_INITIAL_CAP)
    mut i = 0
    while i < SET_INITIAL_CAP:
        s.keys[i] = -1
        i += 1
    return s